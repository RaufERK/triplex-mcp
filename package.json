{
  "name": "triplex-mcp",
  "version": "0.1.0",
  "description": "Minimal MCP server for Triplex docs",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
